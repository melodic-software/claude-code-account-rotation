<Project Sdk="Microsoft.NET.Sdk">

  <!-- The executable: Kestrel on loopback, minimal API, embedded page. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClaudeCodeAccountRotation.App</RootNamespace>
    <AssemblyName>claude-code-account-rotation</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Both sides of a machine: the Windows leader and the WSL follower are
         one executable published twice. Declared here rather than passed to
         publish, so a locked-mode restore resolves both runtime graphs and a
         RID publish adds nothing to packages.lock.json. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <!-- LibraryImport's generated string marshaling for the exclusive-mkdir
         P/Invokes behind the refresh lock. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page and the first-run template ship inside the executable. The
         follower-log wrapper is the one file published beside it. -->
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="config.template.json">
      <LogicalName>ClaudeCodeAccountRotation.App.config.template.json</LogicalName>
    </EmbeddedResource>
    <!-- The leader execs this beside the Linux binary. It stays a file:
         wsl.exe cannot run a script embedded in the single-file bundle. -->
    <Content Include="follower-log" Link="claude-code-account-rotation-follower-log" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <TargetPath>claude-code-account-rotation-follower-log</TargetPath>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClaudeCodeAccountRotation.Core/ClaudeCodeAccountRotation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory<Program> hosts the app in-process; the implicit
         top-level Program type stays internal. -->
    <InternalsVisibleTo Include="ClaudeCodeAccountRotation.App.Tests" />
  </ItemGroup>

</Project>
